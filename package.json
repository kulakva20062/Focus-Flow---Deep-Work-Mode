{
  "name": "focus-flow",
  "displayName": "Focus Flow",
  "description": "Быстрый переход в режим фокуса и обратно",
  "version": "0.0.1",
  "publisher": "your-name",
  "repository": {
    "type": "git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Productivity"],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:focus-flow.saveStandardLayout",
    "onCommand:focus-flow.enterFocusMode",
    "onCommand:focus-flow.enterStandardMode"
  ],
  "contributes": {
    "commands": [
      {
        "command": "focus-flow.saveStandardLayout",
        "title": "Focus Flow: Сохранить стандартный layout"
      },
      {
        "command": "focus-flow.enterFocusMode",
        "title": "Focus Flow: Войти в режим фокуса"
      },
      {
        "command": "focus-flow.enterStandardMode",
        "title": "Focus Flow: Вернуться в стандартный режим"
      }
    ],
    "configuration": {
      "title": "Focus Flow",
      "properties": {
        "focus-flow.switchThemeInFocus": {
          "type": "boolean",
          "default": true,
          "description": "Переключать тему при входе в режим фокуса"
        },
        "focus-flow.highContrastTheme": {
          "type": "string",
          "default": "Default High Contrast",
          "description": "Тема для режима фокуса"
        },
        "focus-flow.toggleFullScreen": {
          "type": "boolean",
          "default": false,
          "description": "Переключать полноэкранный режим при входе/выходе"
        }
      }
    }
  }
}